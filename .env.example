# ==============================================================================
# Atuzz CertAgent Private - Production Environment Variables Template
# ==============================================================================

# HTTP service port (default: 3000, serves root certificate and installer scripts)
PORT=3000

# HTTPS secure console port (default: 3443, Central Web Management Dashboard)
HTTPS_PORT=3443

# Timezone configuration (default: Asia/Shanghai or UTC)
TZ=Asia/Shanghai

# Runtime environment
NODE_ENV=production

# Root CA Common Name (CN) and Organization (ORG)
ROOT_CA_CN=Atuzz CertAgent Enterprise Root CA
ROOT_CA_ORG=Atuzz CertAgent CA

# Automated certificate renewal threshold in days (default: 30 days before expiration)
RENEWAL_THRESHOLD_DAYS=30
